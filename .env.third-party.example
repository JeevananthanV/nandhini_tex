# ============================================================================
# Third-Party Integrations — Environment Variables Template
# ============================================================================
# Copy the relevant sections to your .env file.
# All integrations are OPTIONAL — the app runs with zero integrations (COD-only).
#
# Generate strong secrets:
#   openssl rand -base64 32
# ============================================================================

# ============================================================================
# REQUIRED (app won't start in production without these)
# ============================================================================

# Primary data store — SQLite for dev, Postgres for production multi-instance
DATABASE_URL="file:./db/custom.db"
# DATABASE_URL="postgresql://user:pass@host:5432/nandhini_tex?schema=public"

# Admin authentication (min 12 chars in production)
ADMIN_PASSWORD="change-this-to-a-strong-password-min-12-chars"
# HMAC signing secret for session tokens (generate: openssl rand -base64 32)
ADMIN_SESSION_SECRET=""

# ============================================================================
# PAYMENTS — Razorpay
# ============================================================================
# India's leading payment gateway. UPI, cards, netbanking, wallets.
# Sign up: https://dashboard.razorpay.com
# Test keys start with rzr_test_, live keys with rzr_live_

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional — for webhook signature verification (recommended for production)
RAZORPAY_WEBHOOK_SECRET=""

# ============================================================================
# SHIPPING — Shiprocket
# ============================================================================
# Aggregates Delhivery, DTDC, India Post, BlueDart, Xpressbees.
# Sign up: https://app.shiprocket.in
# Tip: Create a dedicated "API User" rather than using your main account.

SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Pickup location name (configured in Shiprocket dashboard → Pickup Locations)
SHIPROCKET_PICKUP_LOCATION="Elampillai"
# Set to "true" to use sandbox mode (for testing)
SHIPROCKET_SANDBOX="false"

# ============================================================================
# EMAIL — Resend
# ============================================================================
# Modern transactional email API. Free: 3k/month, 100/day.
# Sign up: https://resend.com
# On free tier, RESEND_FROM_EMAIL must be onboarding@resend.dev
# After verifying your domain, use noreply@yourdomain.com

RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_REPLY_TO="support@nandhinitex.com"

# ============================================================================
# SMS — MSG91
# ============================================================================
# India-focused SMS provider. Free: 130 credits on signup.
# Sign up: https://msg91.com
# IMPORTANT: TRAI requires DLT-approved templates for all transactional SMS.
# Register templates at https://msg91.com/dlt

MSG91_AUTH_KEY=""
MSG91_SENDER_ID="NDHTXT"
MSG91_TEMPLATE_ID=""

# ============================================================================
# ANALYTICS — Plausible
# ============================================================================
# Privacy-friendly, cookie-free analytics. No cookie banner needed (GDPR-compliant).
# Sign up: https://plausible.io (or self-host)
# The NEXT_PUBLIC_ vars are visible in the browser (that's OK — they're public)

NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
# Server-side API key for custom events (optional)
PLAUSIBLE_API_KEY=""

# ============================================================================
# ERROR MONITORING — Sentry
# ============================================================================
# Free: 5k errors/month, 50 performance transactions.
# Sign up: https://sentry.io
# Requires: bun add @sentry/nextjs
# Then uncomment the implementation in src/lib/integrations/sentry.ts

SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Usually same as SENTRY_DSN (rare to have separate)
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================================================
# SECURITY — Cloudflare Turnstile (CAPTCHA)
# ============================================================================
# Free, unlimited. Replaces Google reCAPTCHA. No cookie banner needed.
# Sign up: https://dash.cloudflare.com/?to=/:account/turnstile

NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ============================================================================
# AI — Z.AI Web Dev SDK
# ============================================================================
# LLM chatbot, image generation, vision understanding, TTS, ASR.
# MUST be used backend-only — never in client-side code.
# The API key must NEVER reach the browser bundle.

ZAI_API_KEY=""

# ============================================================================
# PUBLIC SITE CONFIG (visible to the browser)
# ============================================================================

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="917604811838"
