# ============================================================================
# Development environment template
# ============================================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# For production, see .env.production.example
# For Docker, see .env.docker.example
# ============================================================================

# ---- Database (required) ----
DATABASE_URL="file:./db/custom.db"

# ---- Admin authentication ----
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET=""

# ---- Public site config ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="917604811838"

# ============================================================================
# THIRD-PARTY INTEGRATIONS (all optional — app works without any of these)
# ============================================================================
# Each integration gracefully no-ops if its env vars are not set.
# See THIRD_PARTY.md for setup instructions.

# ---- Payments: Razorpay (https://dashboard.razorpay.com) ----
# Test keys start with `rzr_test_`. Live keys start with `rzr_live_`.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Shipping: Shiprocket (https://app.shiprocket.in) ----
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_SANDBOX="false"

# ---- Email: Resend (https://resend.com) ----
# Free tier: 3k emails/month. Use onboarding@resend.dev until you verify your domain.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_REPLY_TO=""

# ---- SMS: MSG91 (https://msg91.com) ----
# Requires DLT-approved template. Register at https://msg91.com/dlt
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# ---- Analytics: Plausible (https://plausible.io) ----
# Privacy-friendly, cookie-free. Self-host or use cloud.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC=""
PLAUSIBLE_API_KEY=""

# ---- Error monitoring: Sentry (https://sentry.io) ----
# Requires `bun add @sentry/nextjs` to enable (see THIRD_PARTY.md)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- Security: Cloudflare Turnstile (https://dash.cloudflare.com/turnstile) ----
# Free, unlimited CAPTCHA. Replaces reCAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- AI: Z.AI SDK (backend-only — never client-side) ----
ZAI_API_KEY=""

# ---- Optional: NextAuth (unused — kept for future multi-user auth) ----
NEXTAUTH_SECRET="replace-me-with-a-strong-random-string"
NEXTAUTH_URL="http://localhost:3000"
