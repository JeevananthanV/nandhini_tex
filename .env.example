# ============================================================================
# Development environment template
# ============================================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# For production, see .env.production.example
# ============================================================================

# ---- Database (required) ----
# SQLite file (relative to project root). Default works for dev.
DATABASE_URL="file:./db/custom.db"

# ---- Admin authentication ----
# Dev default: "admin123" (used if ADMIN_PASSWORD is unset in non-production).
# Set this to a strong password (min 12 chars) even in dev to test real auth.
ADMIN_PASSWORD="admin123"

# Optional — dedicated secret for signing session tokens.
# If unset, derived from ADMIN_PASSWORD. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# ---- Public site config (visible to the browser) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="917604811838"

# ---- Optional: AI features (z-ai-web-dev-sdk — backend only) ----
ZAI_API_KEY=""

# ---- Optional: NextAuth (unused — kept for future multi-user auth) ----
NEXTAUTH_SECRET="replace-me-with-a-strong-random-string"
NEXTAUTH_URL="http://localhost:3000"
