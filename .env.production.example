# ============================================================================
# Production environment template
# ============================================================================
# Copy to .env.production (or set as real env vars on your hosting platform)
#   cp .env.production.example .env.production
#
# IMPORTANT: Never commit .env.production to git. The .gitignore already
# excludes it. For Docker deploys, pass these via `docker run -e` or
# your orchestrator's secret management (Docker Swarm secrets, K8s secrets).
# ============================================================================

# ---- Database (required) ----
# SQLite (single-instance only — the db/custom.db file is included in the
# standalone build). For multi-instance deploys, switch to PostgreSQL.
DATABASE_URL="file:/app/db/custom.db"

# Example PostgreSQL (recommended for production multi-instance):
# DATABASE_URL="postgresql://user:password@db-host:5432/nandhini_tex?schema=public"

# ---- Admin authentication (REQUIRED — production will refuse to start without) ----
# Strong password (min 12 chars). Generate with: openssl rand -base64 18
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS"

# HMAC signing secret for session tokens. Generate with: openssl rand -base64 32
# If unset, derived from ADMIN_PASSWORD (less secure — rotating the password
# invalidates all sessions).
ADMIN_SESSION_SECRET="REPLACE_WITH_32_BYTE_BASE64_SECRET"

# ---- Public site config (visible to the browser) ----
NEXT_PUBLIC_SITE_URL="https://your-production-domain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="917604811838"

# ---- Optional: NextAuth (unused — kept for future multi-user auth) ----
NEXTAUTH_SECRET="REPLACE_WITH_32_BYTE_BASE64_SECRET"
NEXTAUTH_URL="https://your-production-domain.com"

# ---- Optional: AI features (z-ai-web-dev-sdk — backend only) ----
ZAI_API_KEY=""

# ---- Optional: error monitoring (Sentry) ----
# SENTRY_DSN=""
