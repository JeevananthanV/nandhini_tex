# ============================================================================
# Production environment template
# ============================================================================
# Copy to .env.production (or set as real env vars on your hosting platform)
#   cp .env.production.example .env.production
#
# IMPORTANT: Never commit .env.production to git. The .gitignore already
# excludes it.
# ============================================================================

# ---- Database (required) ----
DATABASE_URL="file:/app/db/custom.db"
# For PostgreSQL (recommended for production multi-instance):
# DATABASE_URL="postgresql://user:password@db-host:5432/nandhini_tex?schema=public"

# ---- Admin authentication (REQUIRED — production will refuse to start without) ----
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS"
ADMIN_SESSION_SECRET="REPLACE_WITH_32_BYTE_BASE64_SECRET"

# ---- Public site config ----
NEXT_PUBLIC_SITE_URL="https://your-production-domain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="917604811838"

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# All optional — app works without any of these (falls back to COD, no email/SMS).
# See THIRD_PARTY.md for setup instructions.

# ---- Payments: Razorpay ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Shipping: Shiprocket ----
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_SANDBOX="false"

# ---- Email: Resend (verify your domain first at https://resend.com/domains) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@your-production-domain.com"
RESEND_REPLY_TO="support@your-production-domain.com"

# ---- SMS: MSG91 (requires DLT-approved template) ----
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# ---- Analytics: Plausible ----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="your-production-domain.com"
NEXT_PUBLIC_PLAUSIBLE_SRC=""
PLAUSIBLE_API_KEY=""

# ---- Error monitoring: Sentry (requires `bun add @sentry/nextjs`) ----
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- Security: Cloudflare Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- AI: Z.AI SDK ----
ZAI_API_KEY=""

# ---- NextAuth (unused — kept for future multi-user auth) ----
NEXTAUTH_SECRET="REPLACE_WITH_32_BYTE_BASE64_SECRET"
NEXTAUTH_URL="https://your-production-domain.com"
