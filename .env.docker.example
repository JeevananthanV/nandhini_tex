# ============================================================================
# .env — Docker runtime environment (used by docker-compose.yml env_file)
# ============================================================================
# Copy to .env and fill in real values:
#   cp .env.docker.example .env
# ============================================================================

# ---- Database ----
DATABASE_URL="file:/app/db/custom.db"
# For PostgreSQL (uncomment + add a `db` service to docker-compose.yml):
# DATABASE_URL="postgresql://nandhini:strong-password@db:5432/nandhini_tex?schema=public"

# ---- Admin authentication (REQUIRED — container will exit without these) ----
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS"
ADMIN_SESSION_SECRET="REPLACE_WITH_32_BYTE_BASE64_SECRET"

# ---- Public site config ----
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="917604811838"

# ============================================================================
# THIRD-PARTY INTEGRATIONS (all optional — app works without any of these)
# ============================================================================

# ---- Payments: Razorpay ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Shipping: Shiprocket ----
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_SANDBOX="false"

# ---- Email: Resend ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_REPLY_TO=""

# ---- SMS: MSG91 ----
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# ---- Analytics: Plausible ----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC=""
PLAUSIBLE_API_KEY=""

# ---- Error monitoring: Sentry ----
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- Security: Cloudflare Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- AI: Z.AI SDK ----
ZAI_API_KEY=""

# ---- Optional: PostgreSQL (if using the `db` service in docker-compose.yml) ----
# POSTGRES_PASSWORD="change-me-strong-password"
