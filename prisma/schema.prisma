// Nandhini Tex Sarees E-Commerce Platform
// Prisma schema — SQLite (single-vendor, INR, India-only for Phase 1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  bannerImage String?
  sortOrder   Int       @default(0)
  productCount Int      @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  description      String
  shortDescription String?
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  status           String    @default("published") // draft | published | archived
  basePrice        Float
  mrp              Float
  discountPct      Float     @default(0)
  fabricType       String?
  weaveOrigin      String?
  weaveDays        Int?
  zariType         String?
  careInstructions String?
  blouseIncluded   Boolean   @default(true)
  blouseLengthM     Float     @default(0.8)
  images           String    @default("[]") // JSON array of urls
  videoUrl         String?
  tags             String    @default("[]") // JSON array of strings
  isBestseller     Boolean   @default(false)
  isNew            Boolean   @default(false)
  isFeatured       Boolean   @default(false)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  variants         Variant[]
  reviews          Review[]

  @@index([categoryId])
  @@index([status])
}

model Variant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color         String
  colorHex      String?
  size          String?
  sku           String
  stockQty      Int      @default(0)
  priceOverride Float?

  @@index([productId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName   String
  authorCity   String?
  authorEmail  String?
  rating       Int
  title        String
  body         String
  media        String   @default("[]") // JSON array of urls
  status       String   @default("pending") // pending | approved | rejected
  verified     Boolean  @default(true)
  helpfulCount Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String   @default("{}") // JSON
  items           String   @default("[]") // JSON array of {title, variant, qty, price, image}
  status          String   @default("pending") // pending|confirmed|packed|shipped|out_for_delivery|delivered|cancelled|returned|refunded
  paymentStatus   String   @default("pending") // pending|paid|failed|refunded
  paymentMethod   String   @default("cod") // cod|upi|card|netbanking
  subtotal        Float    @default(0)
  discount        Float    @default(0)
  shippingFee     Float    @default(0)
  codSurcharge    Float    @default(0)
  tax             Float    @default(0)
  grandTotal      Float    @default(0)
  couponCode      String?
  courier         String   @default("{}") // JSON {name, awb, trackingUrl}
  timeline        String   @default("[]") // JSON array of {status, timestamp, note}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  description  String?
  type         String    // percent | flat
  value        Float
  minCartValue Float     @default(0)
  usageLimit   Int       @default(0) // 0 = unlimited
  usedCount    Int       @default(0)
  perUserLimit Int      @default(1)
  startsAt     DateTime  @default(now())
  expiresAt    DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String?
  quote     String
  rating    Int      @default(5)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Faq {
  id        String  @id @default(cuid())
  question String
  answer    String
  category  String @default("General") // Shipping|Returns|COD|Payments|Sarees|Care
  sortOrder Int    @default(0)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  email      String?
  city       String?
  totalOrders Int     @default(0)
  totalSpent Float    @default(0)
  segment    String   @default("regular") // regular|vip|wholesale|bridal_lead
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
